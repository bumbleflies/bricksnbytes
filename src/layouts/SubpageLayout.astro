---
// Shared template for all subpages: small page hero, readable content column,
// contact/booking block at the end. Header and footer come from Layout.
import Layout from './Layout.astro';
import CTASection from '../components/CTASection.astro';
import { EMAIL_HREF, SHOP_URL } from '../data/site';

interface Props {
  title: string;
  // One or two sentences shown under the title
  intro?: string;
  description?: string;
  // Wide content area for tile grids instead of the ~70ch text column
  wide?: boolean;
  ctaHeadline?: string;
  ctaText?: string;
  // Hide the closing contact/booking block (e.g. legal pages)
  showCta?: boolean;
}

const {
  title,
  intro,
  description = intro,
  wide = false,
  ctaHeadline = 'Fragen oder Lust auf einen Kurs?',
  ctaText = 'Buche direkt im Shop oder schreib uns – wir beraten dich gern.',
  showCta = true,
} = Astro.props;
---

<Layout title={title} description={description}>
  <section class="page-hero">
    <div class="page-hero-inner">
      <h1>{title}</h1>
      {intro && <p class="page-intro">{intro}</p>}
    </div>
  </section>

  <div class={`page-content ${wide ? 'page-content-wide' : ''}`}>
    <slot />
  </div>

  {showCta && (
    <CTASection
      headline={ctaHeadline}
      subheading={ctaText}
      buttonText="Kurs buchen"
      buttonHref={SHOP_URL}
      buttonExternal
      secondaryText="Kontakt aufnehmen"
      secondaryHref={EMAIL_HREF}
    />
  )}
</Layout>

<style>
  .page-hero {
    padding: 48px clamp(16px, 4vw, 48px) 32px;
  }

  .page-hero-inner {
    max-width: 70ch;
    margin: 0 auto;
  }

  .page-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 2.75rem);
    line-height: 1.1;
    color: var(--ink);
    margin: 0 0 12px;
  }

  .page-intro {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
  }

  .page-content {
    max-width: 70ch;
    margin: 0 auto;
    padding: 8px clamp(16px, 4vw, 48px) 64px;
    box-sizing: content-box;
    line-height: 1.7;
  }

  .page-content-wide {
    max-width: 1100px;
  }

  /* Readable defaults for text content inside the slot */
  .page-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--ink);
    margin: 2rem 0 0.5rem;
  }

  .page-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    margin: 1.5rem 0 0.4rem;
  }

  .page-content :global(p),
  .page-content :global(li) {
    color: var(--ink-soft);
    line-height: 1.7;
  }

  /* Inline text links only; buttons and tiles keep their own colours */
  .page-content :global(p a),
  .page-content :global(li a) {
    color: var(--coral-deep);
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 32px 16px 20px;
    }

    .page-intro {
      font-size: 1.05rem;
    }

    .page-content {
      padding: 0 16px 48px;
    }
  }
</style>
