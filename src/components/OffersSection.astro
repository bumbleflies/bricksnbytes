---
import { getCollection } from 'astro:content';
import { pickImage, withFormats } from '../data/pickImage';
import BlobTile from './BlobTile.astro';
import TileGrid from './TileGrid.astro';

const offers = (await getCollection('offers')).sort((a, b) => a.data.order - b.data.order);
---

<section class="offers-section" id="angebote">
  <!-- Floating deco elements -->
  <div class="deco deco-oval deco-g1" style="width:22px;height:30px;background:#4caf50;top:28px;left:6%;"></div>
  <div class="deco deco-dot deco-g2" style="width:18px;height:18px;background:#2196f3;top:18px;left:30%;"></div>
  <div class="deco deco-oval deco-g3" style="width:20px;height:26px;background:#ff9800;top:26px;left:56%;"></div>
  <div class="deco deco-oval deco-g4" style="width:18px;height:24px;background:#26a6a1;top:22px;right:6%;"></div>
  <div class="deco deco-dash deco-g5" style="width:32px;height:10px;background:#ff9800;bottom:85px;left:7%;"></div>
  <div class="deco deco-dash deco-g6" style="width:28px;height:10px;background:#2196f3;bottom:80px;right:9%;"></div>

  <div class="container">
    <h2 class="section-heading">Unsere Angebote</h2>
    <p class="section-sub">Für jedes Alter und jeden Anlass das Passende</p>

    <TileGrid count={offers.length}>
      {offers.map((offer, idx) => (
        <BlobTile
          title={offer.data.name}
          href={offer.data.href}
          age={offer.data.audience}
          description={offer.data.description}
          image={pickImage(
            [...withFormats(`/images/angebot-${offer.data.slug}`), ...withFormats(`/images/angebote/angebot-${offer.data.slug}`)],
            offer.data.image
          )}
          imageAlt={offer.data.imageAlt}
          color={offer.data.color}
          index={idx}
        />
      ))}
    </TileGrid>
  </div>

  <!-- Coral wave at bottom -->
  <div class="coral-wave"></div>
</section>

<style>
  .offers-section {
    position: relative;
    padding: 64px 32px 130px;
    background: #fff;
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .section-heading {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.8rem;
    font-weight: 700;
    text-align: center;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .section-sub {
    text-align: center;
    color: var(--ink-soft);
    margin: 0 0 40px;
  }

  /* Floating decorative elements */
  .deco {
    position: absolute;
    pointer-events: none;
    z-index: 5;
  }

  .deco-oval {
    border-radius: 50%;
    transform: rotate(-25deg);
  }

  .deco-dash {
    border-radius: 99px;
    transform: rotate(-35deg);
  }

  .deco-dot {
    border-radius: 50%;
  }

  /* Coral wave at bottom */
  .coral-wave {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 110%;
    height: 100px;
    background: var(--coral);
    border-radius: 50% 50% 0 0 / 80% 80% 0 0;
    z-index: 1;
  }

  /* Mobile: stack cards in 2x2 grid */
  @media (max-width: 768px) {
    .section-heading {
      font-size: 1.4rem;
    }

    .offers-section {
      padding: 48px 20px 110px;
    }
  }

  @media (max-width: 480px) {
    .offers-section {
      padding: 40px 16px 90px;
    }
  }
</style>
