---
// Numbered steps next to a photo — the layout of "Was uns besonders macht" (photo | numbered list)
interface Props {
  steps: { title: string; text?: string }[];
  image: string;
  imageAlt: string;
}

const { steps, image, imageAlt } = Astro.props;
const colors = ['var(--coral)', '#2196f3', '#26a6a1', 'var(--violet)'];
---

<div class="steps-grid">
  <div class="photo-wrap">
    <img src={image} alt={imageAlt} loading="lazy" />
  </div>
  <ol class="steps">
    {steps.map((step, idx) => (
      <li class="step">
        <span class="step-num" style={`background:${colors[idx % colors.length]};`} aria-hidden="true">{idx + 1}</span>
        <div>
          <h3>{step.title}</h3>
          {step.text && <p>{step.text}</p>}
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .steps-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    max-width: 860px;
    margin: 0 auto;
  }

  .photo-wrap img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 28px;
    transform: rotate(-2deg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.14);
    display: block;
    background: var(--cream-2);
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .step {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .step-num {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Fredoka', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
  }

  .step h3 {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    margin: 8px 0 4px;
  }

  .step p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .steps-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .photo-wrap {
      width: 70%;
      margin: 0 auto;
    }
  }
</style>
