---
import { SHOP_URL, PHONE_HREF } from '../data/site';

interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const navItems = [
  { label: lang === 'de' ? 'Kurse' : 'Courses', href: '/kurse' },
];

const ctaLabel = lang === 'de' ? 'Kurs buchen' : 'Book Course';
const phoneLabel = lang === 'de' ? 'Anrufen' : 'Call';

// Detect current page for active state
const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
---

<div class="nav-outer">
  <nav class="nav-pill" aria-label="Hauptmenü">
    <a href="/" class="logo" aria-label="BricksnBytes Startseite">
      <div class="logo-mark"></div>
      <span class="logo-word">Bricksn<b>Bytes</b></span>
    </a>

    <div class="nav-links">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            class={`nav-link ${isActive ? 'active' : ''}`}
            {...(isActive && { 'aria-current': 'page' })}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <!-- Text buttons on desktop, icon-only (Lucide) on mobile -->
    <div class="nav-right">
      <a href={PHONE_HREF} class="cta-ghost" aria-label={phoneLabel}>
        <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span class="btn-label">{phoneLabel}</span>
      </a>
      <a href={SHOP_URL} target="_blank" rel="noopener noreferrer" class="cta" aria-label={ctaLabel}>
        <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 2v4" />
          <path d="M16 2v4" />
          <rect width="18" height="18" x="3" y="4" rx="2" />
          <path d="M3 10h18" />
          <path d="m9 16 2 2 4-4" />
        </svg>
        <span class="btn-label">{ctaLabel}</span>
      </a>
    </div>
  </nav>
</div>

<style>
  /* Floating pill nav — Direction B */
  .nav-outer {
    position: sticky;
    top: 20px;
    z-index: 100;
    padding: 0 clamp(16px, 4vw, 48px);
    pointer-events: none;
    padding-top: 20px;
    transition: padding-top 180ms ease;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 10px 12px 10px 18px;
    background: oklch(1 0 0 / .82);
    backdrop-filter: blur(10px);
    border: 1px solid oklch(1 0 0 / .9);
    border-radius: var(--r-pill);
    box-shadow: var(--shadow-md);
    pointer-events: auto;
    transition: padding var(--transition-fast), box-shadow var(--transition-fast);
  }

  .nav-pill.scrolled {
    padding: 6px 10px 6px 14px;
    box-shadow: var(--shadow-sm);
  }

  /* Logo mark with studs */
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(135deg, var(--coral), var(--coral-deep));
    flex-shrink: 0;
    position: relative;
    box-shadow: var(--shadow-sm);
  }

  .logo-mark::after {
    content: "";
    position: absolute;
    top: 6px;
    left: 8px;
    right: 8px;
    height: 5px;
    border-radius: 5px;
    background: radial-gradient(circle at 4px 50%, oklch(1 0 0/.85) 0 2px, transparent 2.5px),
                radial-gradient(circle at 14px 50%, oklch(1 0 0/.85) 0 2px, transparent 2.5px),
                radial-gradient(circle at 24px 50%, oklch(1 0 0/.85) 0 2px, transparent 2.5px);
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .logo-word b {
    color: var(--coral);
    font-weight: 600;
  }

  /* Nav links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: 6px;
  }

  .nav-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14.5px;
    color: var(--ink);
    text-decoration: none;
    padding: 9px 15px;
    border-radius: var(--r-pill);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background var(--transition-fast), color var(--transition-fast);
    white-space: nowrap;
  }

  .nav-link:hover {
    background: oklch(1 0 0 / .75);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .nav-link:active,
  .nav-link.active {
    background: var(--coral-soft);
    color: var(--coral-deep);
  }

  .nav-link:focus-visible,
  .cta:focus-visible,
  .cta-ghost:focus-visible {
    outline: 3px solid var(--coral);
    outline-offset: 2px;
  }

  /* Right action buttons */
  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .cta, .cta-ghost {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    border: none;
    cursor: pointer;
    padding: 11px 20px;
    border-radius: var(--r-pill);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cta {
    background: var(--coral);
    color: #fff;
    box-shadow: 0 6px 16px -6px var(--coral-deep);
  }

  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 22px -6px var(--coral-deep);
  }

  .cta-ghost {
    background: transparent;
    color: var(--ink);
    box-shadow: none;
    border: 1.5px solid var(--line);
  }

  .cta-ghost:hover {
    background: oklch(1 0 0 / .75);
    box-shadow: var(--shadow-sm);
  }

  .icon {
    display: none;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .nav-pill {
      gap: 8px;
      padding: 8px 8px 8px 12px;
    }

    .nav-links {
      margin-left: 0;
    }

    .nav-link {
      padding: 10px 12px;
      min-height: 44px;
      box-sizing: border-box;
    }

    .nav-right {
      gap: 8px;
    }

    /* Icon-only buttons with a 44×44 tap area */
    .cta, .cta-ghost {
      width: 44px;
      height: 44px;
      padding: 0;
      box-sizing: border-box;
    }

    .icon {
      display: block;
    }

    .btn-label {
      display: none;
    }

    .logo-word {
      font-size: 16px;
    }
  }

  /* Very narrow phones: keep logo mark, drop the word mark */
  @media (max-width: 359px) {
    .logo-word {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill,
    .nav-outer,
    .cta,
    .nav-link {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  // Scroll behavior for nav shrink
  const navPill = document.querySelector('.nav-pill');
  const navOuter = document.querySelector('.nav-outer');

  if (navPill) {
    const handleScroll = () => {
      const scrolled = window.scrollY > 24;
      navPill.classList.toggle('scrolled', scrolled);
      if (navOuter instanceof HTMLElement) {
        navOuter.style.paddingTop = scrolled ? '12px' : '20px';
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
  }
</script>
