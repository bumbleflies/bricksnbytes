---
interface Props {
  headline: string;
  subheading?: string;
  buttonText: string;
  buttonHref: string;
}

const { headline, subheading, buttonText, buttonHref } = Astro.props;
---

<section class="cta-section">
  <!-- Coral blob island background -->
  <div class="cta-blob"></div>

  <!-- Floating decorative elements -->
  <div class="cta-deco cta-star-1">✦</div>
  <div class="cta-deco cta-star-2">★</div>
  <div class="cta-deco cta-dot-1"></div>
  <div class="cta-deco cta-dot-2"></div>

  <!-- Container wraps content -->
  <div class="container">
    <div class="cta-inner">
      <h2>{headline}</h2>
      {subheading && <p>{subheading}</p>}
      <a href={buttonHref} class="cta-btn">{buttonText}</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding: 80px 40px 100px;
    background: #fff;
    overflow: hidden;
  }

  .cta-blob {
    position: absolute;
    width: 800px;
    height: 500px;
    background: var(--coral);
    border-radius: 55% 45% 50% 50% / 50% 48% 52% 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  /* Floating decorative elements outside blob */
  .cta-deco {
    position: absolute;
    pointer-events: none;
    z-index: 3;
  }

  .cta-star-1 {
    font-size: 2rem;
    top: 20px;
    left: 12%;
    color: var(--yellow);
    opacity: 0.85;
    animation: spin-star 8s linear infinite;
  }

  .cta-star-2 {
    font-size: 1.4rem;
    bottom: 24px;
    right: 14%;
    color: #2196f3;
    opacity: 0.7;
    animation: spin-star 12s linear infinite reverse;
  }

  .cta-dot-1 {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #26a6a1;
    top: 30px;
    right: 20%;
  }

  .cta-dot-2 {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--yellow);
    bottom: 30px;
    left: 18%;
  }

  @keyframes spin-star {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* CTA content inside blob */
  .cta-inner {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .cta-inner h2 {
    font-family: 'Fredoka', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: white;
    margin-bottom: 12px;
    margin: 0 0 12px 0;
  }

  .cta-inner p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 28px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    margin: 0 auto 28px;
  }

  .cta-btn {
    display: inline-block;
    background: white;
    color: oklch(0.62 0.170 35);
    font-family: 'Fredoka', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    padding: 13px 36px;
    border-radius: 99px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    text-decoration: none;
    transition: transform 0.2s;
  }

  .cta-btn:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 60px 30px 80px;
    }

    .cta-blob {
      width: 500px;
      height: 350px;
    }

    .cta-inner h2 {
      font-size: 1.5rem;
    }

    .cta-inner p {
      font-size: 0.9rem;
    }

    .cta-star-1,
    .cta-star-2 {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .cta-section {
      padding: 50px 20px 70px;
    }

    .cta-blob {
      width: 320px;
      height: 280px;
    }

    .cta-inner h2 {
      font-size: 1.2rem;
    }

    .cta-inner p {
      font-size: 0.85rem;
      margin-bottom: 20px;
    }

    .cta-btn {
      font-size: 0.95rem;
      padding: 11px 28px;
    }

    .cta-dot-1,
    .cta-dot-2 {
      width: 14px;
      height: 14px;
    }
  }
</style>
