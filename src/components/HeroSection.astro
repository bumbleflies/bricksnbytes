---
interface Props {
  headline: string;
  subheading: string;
  ctaText: string;
  ctaHref: string;
  chips?: { label: string; color: "coral" | "blue" | "teal" }[];
  imageSrc?: string;
}

const {
  headline,
  subheading,
  ctaText,
  ctaHref,
  chips = [],
  imageSrc = 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&h=400&fit=crop'
} = Astro.props;

const chipColors = {
  coral: "var(--coral-soft)",
  blue: "var(--blue-soft)",
  teal: "var(--teal-soft)",
};
---

<section class="hero">
  <div class="hero-grid">
    <!-- Left column: text content -->
    <div class="hero-left">
      {chips.length > 0 && (
        <div class="chip-row">
          {chips.map((chip) => (
            <span class="chip" style={`background: ${chipColors[chip.color]}`}>
              {chip.label}
            </span>
          ))}
        </div>
      )}
      <h1 class="hero-h1">{headline}</h1>
      <p class="hero-subheading">{subheading}</p>
      <a href={ctaHref} class="cta">{ctaText}</a>
    </div>

    <!-- Right column: image -->
    <div class="hero-right">
      <div class="hero-image">
        <img src={imageSrc} alt="Hero" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 2;
    padding: 40px clamp(20px, 4vw, 48px) 38px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 24px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .chip-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .chip {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    padding: 6px 13px;
    border-radius: var(--r-pill);
    color: var(--ink);
    display: inline-block;
  }

  .hero-h1 {
    font-size: 48px;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    color: var(--ink);
    position: relative;
  }

  .hero-h1 :global(.u) {
    position: relative;
    white-space: nowrap;
  }

  .hero-h1 :global(.u::after) {
    content: "";
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: 4px;
    height: 12px;
    background: var(--yellow);
    border-radius: 6px;
    z-index: -1;
  }

  .hero-subheading {
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 28em;
    margin: 0 0 22px;
  }

  .cta {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    background: var(--coral);
    color: #fff;
    border: none;
    cursor: pointer;
    padding: 11px 20px;
    border-radius: var(--r-pill);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    box-shadow: 0 6px 16px -6px var(--coral-deep);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 22px -6px var(--coral-deep);
  }

  .hero-right {
    position: relative;
  }

  .hero-image {
    height: 300px;
    border-radius: 28px;
    box-shadow: var(--shadow-lg);
    transform: rotate(1.5deg);
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-h1 {
      font-size: 32px;
      line-height: 1.1;
      margin-bottom: 12px;
    }

    .hero-subheading {
      font-size: 15px;
      margin-bottom: 20px;
    }

    .hero-image {
      height: 240px;
    }

    .cta {
      padding: 10px 18px;
      font-size: 14px;
    }
  }
</style>
