---
import SubpageLayout from "../../layouts/SubpageLayout.astro";
import ProgramCard from "../../components/ProgramCard.astro";
import { offerImage } from "../../data/offerImage";

import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const offers = await getCollection('offers');
  const programs = await getCollection('programs');

  return offers.map(offer => {
    const offerPrograms = offer.data.programs.map(slug => {
      const program = programs.find(p => p.data.slug === slug);
      if (!program) throw new Error(`Offer "${offer.data.slug}" references unknown program "${slug}"`);
      return program;
    });
    return {
      params: { slug: offer.data.slug },
      props: { offer, programs: offerPrograms },
    };
  });
}

interface Props {
  offer: CollectionEntry<'offers'>;
  programs: CollectionEntry<'programs'>[];
}

const { offer, programs } = Astro.props;
const image = offerImage(offer.data.slug, offer.data.image);
const intro = offer.data.audience
  ? `${offer.data.description} – ${offer.data.audience}.`
  : `${offer.data.description}.`;
---

<SubpageLayout
  title={offer.data.name}
  intro={intro}
  description={offer.data.description}
  ctaHeadline="Lust bekommen?"
  wide
>
  <h2>Unsere Kurse</h2>
  <div class="grid-3 course-grid">
    {programs.map(program => (
      <ProgramCard
        name={program.data.name}
        description={program.data.description}
        ageGroup={program.data.ageGroupDe}
        duration={program.data.durationDe}
        price={String(program.data.price)}
        image={program.data.image}
        href="/kurse"
        ctaLabel="Termine ansehen"
      />
    ))}
    {offer.data.placeholders.map(title => (
      <div class="placeholder-card">
        <img src={image} alt={offer.data.imageAlt} loading="lazy" />
        <div class="placeholder-body">
          <h3>{title}</h3>
          <p>Beschreibung folgt</p>
        </div>
      </div>
    ))}
  </div>
</SubpageLayout>

<style>
  .placeholder-card {
    background: white;
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .placeholder-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    filter: grayscale(0.4);
    opacity: 0.8;
  }

  .placeholder-body {
    padding: var(--sp-lg);
  }

  .placeholder-body h3 {
    margin: 0 0 var(--sp-sm);
  }

  .placeholder-body p {
    color: var(--ink-faint);
    font-style: italic;
    margin: 0;
  }

  /* One card per row on phones */
  @media (max-width: 768px) {
    .course-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-xl);
    }
  }
</style>
