---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <section class="hero">
    <h1>Welcome to BricksnBytes</h1>
    <p>Professional training and workshops for teams and organizations</p>
  </section>
</Layout>

<style>
  .hero {
    padding: 4rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  h1 {
    margin: 0 0 1rem 0;
    font-size: 3rem;
  }

  p {
    margin: 0;
    font-size: 1.25rem;
  }
</style>
